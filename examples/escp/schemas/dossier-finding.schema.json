{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision-maker dossier for one body (crm/dossiers/<XX>/<body>.yaml). Public record only.",
  "type": "object",
  "required": ["state", "body", "body_type", "official_url", "members", "updated"],
  "properties": {
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "body": { "type": "string" },
    "body_type": { "enum": ["school_board", "house_education_committee", "senate_education_committee", "state_board_of_education", "other"] },
    "district_nces_id": { "type": ["string", "null"], "pattern": "^[0-9]{7}$" },
    "official_url": { "type": "string", "format": "uri" },
    "meeting_schedule": { "type": ["string", "null"] },
    "decisive_votes": { "type": ["integer", "null"] },
    "updated": { "type": "string", "format": "date" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "position_on_cp"],
        "properties": {
          "name": { "type": "string" },
          "seat": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] },
          "term_ends": { "type": ["integer", "string", "null"] },
          "official_url": { "type": ["string", "null"], "format": "uri" },
          "contact": { "type": ["object", "null"], "properties": { "email": { "type": ["string", "null"] }, "phone": { "type": ["string", "null"] } }, "description": "Official, published contact only" },
          "position_on_cp": { "enum": ["supports_ban", "opposes_ban", "open", "unknown"] },
          "evidence": { "type": "array", "items": { "type": "object", "required": ["date", "summary", "url"], "properties": { "date": { "type": "string" }, "summary": { "type": "string" }, "url": { "type": "string", "format": "uri" } } } },
          "values": { "type": "array", "items": { "type": "object", "required": ["quote", "url"], "properties": { "quote": { "type": "string" }, "url": { "type": "string", "format": "uri" } } }, "description": "The member's own words, quoted, with source" },
          "public_affiliations": { "type": "array", "items": { "type": "object", "required": ["type", "name", "url"], "properties": { "type": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } } }, "description": "Self-stated on an official or campaign page only" }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
