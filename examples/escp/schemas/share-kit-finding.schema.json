{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One state's share kit (share/<XX>/)",
  "type": "object",
  "required": ["state", "headline", "body", "claims_used", "last_verified"],
  "properties": {
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "headline": { "type": "string", "maxLength": 120 },
    "body": { "type": "string", "description": "Share text; every number in it must be a claim in claims_used" },
    "claims_used": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "description": "Claim ids, all with status verified" },
    "call_to_action": { "type": ["string", "null"] },
    "link": { "type": ["string", "null"], "format": "uri" },
    "image_alt": { "type": ["string", "null"] },
    "image_path": { "type": ["string", "null"] },
    "last_verified": { "type": "string", "format": "date" },
    "notes": { "type": ["string", "null"] }
  }
}
